{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.png", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2|mp3)"]
      }
    },
    {
      "name": "engine",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/engine/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "club-content",
      "urls": [
        "/api/games",
        "/api/games/**",
        "/api/posts",
        "/api/posts/**",
        "/api/programme",
        "/api/programme/**",
        "/api/books"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "4s",
        "maxSize": 300,
        "maxAge": "60d"
      }
    }
  ]
}
