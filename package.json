{
  "name": "chess-club",
  "version": "0.1.0",
  "description": "Chess Square club PWA: annotated games, programme, news, books and an analysis board.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:start\"",
    "dev:api": "wrangler dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "db:migrate": "wrangler d1 migrations apply chess-club --local",
    "db:migrate:remote": "wrangler d1 migrations apply chess-club --remote",
    "db:seed": "wrangler d1 execute chess-club --local --file=seed/sample.sql",
    "db:seed:remote": "wrangler d1 execute chess-club --remote --file=seed/sample.sql",
    "admin:create": "node scripts/create-admin.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "ng build && wrangler dev",
    "deploy": "ng build && wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "chessground": "^9.2.1",
    "chessops": "^0.15.1",
    "hono": "^4.13.11",
    "marked": "^18.0.14",
    "rxjs": "~7.8.0",
    "stockfish": "^19.0.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.0",
    "concurrently": "^10.0.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.144.0"
  }
}
